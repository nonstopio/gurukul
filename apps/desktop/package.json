{
  "name": "@gurukul/desktop",
  "productName": "Gurukul Studio",
  "version": "0.0.0",
  "private": true,
  "description": "Gurukul Studio desktop shell: an Electron window over the web app, with the window.gurukulDesktop bridge. Plan: .plan/22-desktop-studio.md.",
  "type": "module",
  "license": "MIT",
  "main": "dist/main.cjs",
  "exports": {
    "./bridge": "./src/bridge.ts"
  },
  "scripts": {
    "build": "tsc --noEmit && npm run bundle",
    "bundle": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=dist/main.cjs && esbuild src/preload.ts --bundle --platform=browser --format=cjs --target=es2023 --external:electron --outfile=dist/preload.cjs",
    "dev": "npm run bundle && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@gurukul/schema": "^0.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "electron-updater": "6.8.12",
    "esbuild": "^0.28.2"
  },
  "author": "NonStop io",
  "homepage": "https://github.com/nonstopio/gurukul"
}
