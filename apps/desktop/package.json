{
  "name": "@gurukul/desktop",
  "productName": "Gurukul Studio",
  "version": "0.0.0",
  "private": true,
  "description": "Gurukul Studio desktop shell: an Electron window over the web app, with the window.gurukulDesktop bridge. Plan: .plan/22-desktop-studio.md.",
  "type": "module",
  "license": "MIT",
  "main": "dist/main.cjs",
  "exports": {
    "./bridge": "./src/bridge.ts"
  },
  "scripts": {
    "build": "tsc --noEmit && npm run bundle",
    "bundle": "tsx scripts/bundle.ts",
    "dev": "npm run bundle && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@gurukul/schema": "^0.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
