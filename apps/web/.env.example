# Public Firebase web config for the nonstop-gurukul project.
# These values are not secrets (they ship in the browser bundle), but they are
# configuration, so they live in .env.local (gitignored), never in source.
# Find them in Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
# The Hosting domain, so the iPhone/iPad sign-in redirect stays first-party in Safari. Locally
# (npm run dev) use nonstop-gurukul.firebaseapp.com.
VITE_FIREBASE_AUTH_DOMAIN=nonstop-gurukul.web.app
VITE_FIREBASE_PROJECT_ID=nonstop-gurukul
VITE_FIREBASE_APP_ID=
# GA4 web stream id (G-XXXXXXXXXX): Firebase console → Project settings → Integrations → Google
# Analytics. Without it analytics sends nothing.
VITE_FIREBASE_MEASUREMENT_ID=

# The project's Cloud Storage bucket, where Studio uploads lesson images. Leave it out and it is
# <project id>.firebasestorage.app, which is the default bucket of a new project.
VITE_FIREBASE_STORAGE_BUCKET=nonstop-gurukul.firebasestorage.app
# Set to "true" to talk to local emulators (npm run emulators).
VITE_USE_EMULATORS=false
# Set to "true" only for the production build (deploy.yml does): reports page load and request
# timings to Firebase Performance Monitoring. Leave unset locally and for previews.
VITE_PERFORMANCE_MONITORING=
# Optional: the public address shared in certificate verify links and used for the link-preview
# image (e.g. https://gurukul.nonstopio.com). Unset, links use the address the app is open on and
# previews have no image. Not an http(s) address: the build stops.
VITE_SITE_URL=
# Analytics (docs/analytics.md). Set to "false" to switch every analytics call off.
VITE_ANALYTICS_ENABLED=true
# Set to "true" to send to GA4 from `npm run dev`, with debug_mode so events show in DebugView.
VITE_ANALYTICS_DEBUG=false
# Optional: sent with every event as app_version.
VITE_APP_VERSION=
