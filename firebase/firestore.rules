rules_version = '2';

// Gurukul Firestore rules.
//
// Default deny. Every collection opens explicitly, in its own match block, with
// tests in firebase/rules/test/ for both the allowed and the denied case.
// Roles are custom claims; see .plan/03-auth-and-roles.md.
service cloud.firestore {
  match /databases/{database}/documents {
    // Only verified NonStop io accounts, signed in with Google, count as signed in. A personal
    // Gmail can create an Auth user but can read or write nothing; so can an email/password
    // account, whatever its address says. The domain is compared lower-cased, as the functions'
    // isAllowedEmail does.
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@nonstopio[.]com$');
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // An Educator may edit only the courses that list them in `educatorIds` (the claim alone is not
    // enough; per-course grants stay out of the token). Costs one read, so use it sparingly.
    function isEducatorOf(courseId) {
      return signedIn()
        && request.auth.token.educator == true
        && request.auth.uid in get(/databases/$(database)/documents/courses/$(courseId)).data.educatorIds;
    }

    // A person reads their own profile (an Admin reads any) and may change only their display
    // name and team. Creating the profile and the role mirror is the functions' job (Admin SDK).
    // `nameLower` (people search by name) moves with the display name: a write touching either
    // must leave it equal to the display name lower-cased, so it never goes stale. A new team must
    // be on `config/org.teams` (or `null`); that read is paid only when the team changes, so a team
    // the Admin later removes stays on the profile through name edits.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'nameLower', 'team', 'labels'])
        && request.resource.data.get('labels', 'generic') in ['generic', 'gurukul']
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && (request.resource.data.team == null
            || (request.resource.data.team is string && request.resource.data.team.size() <= 80))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['team'])
            || request.resource.data.team == null
            || request.resource.data.team in get(/databases/$(database)/documents/config/org).data.teams)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName', 'nameLower'])
            || request.resource.data.get('nameLower', null) == request.resource.data.displayName.lower());
      allow create, delete: if false;
    }

    // Assignments are keyed by email and stamped with the uid at first sign-in. The assignee
    // reads their own; an Admin reads all. Writes go through the assignCourses function.
    match /assignments/{assignmentId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // The ids of the teams the signed-in person is on: `users/{uid}.teamIds`, kept by the
    // `onTeamWritten` function from `teams/`, and never writable by the person (see `users` above).
    // Costs one read, and only when a course is `teams`-visible.
    function myTeamIds() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('teamIds', []);
    }

    // Whether the signed-in person may open a published course. Educators and Admins open every
    // course (that is what `staff` visibility means). Everyone else opens a `public` one, and a
    // `teams` one only when they are on one of its `visibleTeamIds`. A document written before
    // visibility existed has neither field and reads as public. Used for single reads; a listing
    // is stricter, because a query cannot be proven against a missing field (see `list` below).
    function canOpenCourse(course) {
      return isAdmin()
        || request.auth.token.educator == true
        || course.get('visibility', 'public') == 'public'
        || (course.visibility == 'teams' && course.visibleTeamIds.hasAny(myTeamIds()));
    }

    // The published course object. Everyone signed in reads published and archived courses they
    // may open (`canOpenCourse`; archived ones show as "Retired"); a never-published one
    // (`status: 'draft'`) is readable by every Educator and Admin, so Studio lists every course. It
    // holds no answer keys and no unpublished edits: those live in `drafts/` below, which stays the
    // course's own Educators'. Only the publish function writes.
    //
    // A listing must say what it asks for: the catalogue runs `visibility == 'public'`, and
    // `visibility == 'teams'` with `visibleTeamIds array-contains-any` the person's own teams, so
    // the rules can prove every document returned is one they may open. Courses published before
    // visibility existed carry `visibility: 'public'` from the one-off backfill
    // (`scripts/backfill-visibility.mjs`); until then they still open by id but are not listed.
    match /courses/{courseId} {
      allow get: if signedIn()
        && (isAdmin()
            || request.auth.token.educator == true
            || (resource.data.status in ['published', 'archived'] && canOpenCourse(resource.data)));
      allow list: if signedIn()
        && (isAdmin()
            || request.auth.token.educator == true
            || (resource.data.status in ['published', 'archived']
                && (resource.data.visibility == 'public'
                    || (resource.data.visibility == 'teams'
                        && resource.data.visibleTeamIds.hasAny(myTeamIds())))));
      allow write: if false;

      // The Studio's working copy: course plus answer keys (an Educator needs them to edit). Saved
      // by the author with a rev check, one step at a time. Created and deleted by functions only.
      match /drafts/{draftId} {
        allow read: if isAdmin() || isEducatorOf(courseId);
        allow update: if (isAdmin() || isEducatorOf(courseId))
          && request.resource.data.keys().hasOnly(['rev', 'updatedAt', 'updatedBy', 'course', 'answers'])
          && request.resource.data.rev is int
          && request.resource.data.rev == resource.data.rev + 1
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && request.resource.data.course is map
          && request.resource.data.course.id == courseId
          && request.resource.data.course.chapters is list
          && request.resource.data.course.chapters.size() <= 30
          && request.resource.data.answers is map;
        allow create, delete: if false;
      }

      // One snapshot per publish, so any version can be rolled back to. Written by functions only.
      match /versions/{version} {
        allow read: if isAdmin() || isEducatorOf(courseId);
        allow write: if false;
      }

      // Who has started this course, by name: `{displayName}` per learner, written by the progress
      // trigger when they start. It is how an Educator sees learner names for their own course
      // without being able to read anyone's profile. Written by functions only.
      match /learners/{uid} {
        allow read: if isAdmin() || isEducatorOf(courseId);
        allow write: if false;
      }

      // Quiz answer keys never reach a browser. Grading runs in a function (Admin SDK).
      match /private/{doc} {
        allow read, write: if false;
      }
    }

    // The shared question bank: any Educator or Admin reads and adds; the creator or an Admin
    // edits the question, its answers and its tags, or removes it. Learners have no access.
    match /questionBank/{entryId} {
      allow read: if signedIn() && (request.auth.token.educator == true || request.auth.token.admin == true);
      allow create: if signedIn()
        && (request.auth.token.educator == true || request.auth.token.admin == true)
        && request.resource.data.keys().hasOnly(['question', 'answers', 'tags', 'createdBy', 'createdAt'])
        && request.resource.data.question is map
        && request.resource.data.answers is list
        && request.resource.data.tags is list
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin()
        || (signedIn() && request.auth.token.educator == true && resource.data.createdBy == request.auth.uid);
      allow update: if (isAdmin()
          || (signedIn() && request.auth.token.educator == true && resource.data.createdBy == request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['question', 'answers', 'tags'])
        && request.resource.data.question is map
        && request.resource.data.answers is list
        && request.resource.data.tags is list;
    }

    // One learner's state in one course, `{uid}_{courseId}`. The learner creates it (starting or
    // self-enrolling in a published course) and may only append completed lesson ids and move the
    // resume point; percent, Quiz results and certificates are written by functions.
    match /progress/{progressId} {
      // `completedItemIds` only grows the way arrayUnion(itemId) grows it: unchanged, or the same
      // list with one new item id (a string of 1-80 characters, the course object's id) on the end.
      // Rules cannot loop, so checking one appended entry is what keeps every entry a string.
      // An empty `before` skips the prefix check: the emulator fails a `[0:0]` slice with an
      // index error, which denied every learner's first completed lesson.
      function appendsAtMostOneItemId(before, after) {
        return after is list
          && after.size() <= 200
          && (after == before
              || (after.size() == before.size() + 1
                  && (before.size() == 0 || after[0:before.size()] == before)
                  && after[before.size()] is string
                  && after[before.size()].size() >= 1
                  && after[before.size()].size() <= 80
                  && !(after[before.size()] in before)));
      }

      // A learner may read their own id before the document exists (the player listens first).
      allow read: if signedIn()
        && (progressId.matches(request.auth.uid + '_.*')
            || (resource != null
                && (resource.data.uid == request.auth.uid
                    || isAdmin()
                    || isEducatorOf(resource.data.courseId))));

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'courseId', 'courseVersion', 'startedAt',
             'lastItemId', 'lastActiveAt', 'completedItemIds', 'quiz', 'percent',
             'completedAt', 'certificateId'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.courseId is string
        && progressId == request.auth.uid + '_' + request.resource.data.courseId
        && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.status == 'published'
        && canOpenCourse(get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data)
        && request.resource.data.courseVersion is int
        && request.resource.data.startedAt == request.time
        && request.resource.data.lastActiveAt == request.time
        && (request.resource.data.lastItemId == null || request.resource.data.lastItemId is string)
        && request.resource.data.completedItemIds == []
        && request.resource.data.quiz == {}
        && request.resource.data.percent == 0
        && request.resource.data.completedAt == null
        && request.resource.data.certificateId == null;

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['completedItemIds', 'lastItemId', 'lastActiveAt', 'courseVersion'])
        && appendsAtMostOneItemId(resource.data.completedItemIds, request.resource.data.completedItemIds)
        && (request.resource.data.lastItemId == null || request.resource.data.lastItemId is string)
        && request.resource.data.lastActiveAt == request.time
        && request.resource.data.courseVersion is int;

      allow delete: if false;

      // One graded attempt, written by gradeAttempt (Admin SDK) with the learner's uid and the
      // course id on it, so reading costs no extra lookup. The learner, an Admin or the course's
      // Educator read it.
      match /attempts/{attemptId} {
        allow read: if signedIn()
          && (resource.data.uid == request.auth.uid
              || isAdmin()
              || isEducatorOf(resource.data.courseId));
        allow write: if false;
      }
    }

    // A certificate is public so anyone can verify it by id, signed in or not: the page shows the
    // name, course, date and status, never an email. Listing is for the owner and Admins (a
    // learner's "my certificates"). Only the progress trigger issues and revokeCertificate edits.
    match /certificates/{certificateId} {
      allow get: if true;
      allow list: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // The certificate sequence counter. Functions only.
    match /counters/{doc} {
      allow read, write: if false;
    }

    // Analytics's counters, kept by triggers and the daily roll-up. `org` and every course's funnel
    // are for Admins; `course_{id}` is also readable by that course's Educator. Never learners;
    // never written from a client.
    match /stats/{scope} {
      allow read: if isAdmin()
        || (scope.matches('course_.+') && isEducatorOf(scope.replace('^course_', '')));
      allow write: if false;
    }

    // The audit trail of Admin actions (roles, assignments, certificates, resets). Read-only
    // for Admins; entries are written by functions.
    match /audit/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // The email outbox the functions queue into. Nothing in a browser may touch it.
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // Organisation settings (`config/org` only): the allowed domain, the teams list, reminder
    // settings and who signs certificates. An Admin edits all but the domain from the console; the
    // domain is fixed here, as `signedIn()` is. Rules cannot loop over a list, so each team name's length is the app's
    // check (`orgConfigSchema`); the list's size is checked here. Never deleted.
    match /config/org {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['domain', 'teams', 'reminders', 'signatory'])
        && request.resource.data.domain == 'nonstopio.com'
        && request.resource.data.teams is list
        && request.resource.data.teams.size() <= 100
        && request.resource.data.reminders is map
        && request.resource.data.reminders.keys().hasOnly(['enabled'])
        && request.resource.data.reminders.enabled is bool
        && request.resource.data.signatory is map
        && request.resource.data.signatory.keys().hasOnly(['name', 'role'])
        && request.resource.data.signatory.name is string
        && request.resource.data.signatory.name.size() > 0
        && request.resource.data.signatory.name.size() <= 120
        && request.resource.data.signatory.role is string
        && request.resource.data.signatory.role.size() > 0
        && request.resource.data.signatory.role.size() <= 120;
    }

    // A team and its members (`teams/{id}`): names are public through `config/org.teams`, the
    // member emails are the Admin's alone. The Teams page writes it in one transaction with
    // `config/org.teams`. Rules cannot loop over a list, so each email's shape is the app's check
    // (`teamSchema`); the key set, name and list size are checked here.
    match /teams/{teamId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'memberEmails', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.memberEmails is list
        && request.resource.data.memberEmails.size() <= 500
        && request.resource.data.createdAt is number;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
