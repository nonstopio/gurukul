rules_version = '2';

// Gurukul Firestore rules.
//
// Default deny. Every collection opens explicitly, in its own match block, with
// tests in firebase/rules/test/ for both the allowed and the denied case.
// Roles are custom claims; see .plan/03-auth-and-roles.md.
service cloud.firestore {
  match /databases/{database}/documents {
    // Only verified NonStop io accounts, signed in with Google, count as signed in. A personal
    // Gmail can create an Auth user but can read or write nothing; so can an email/password
    // account, whatever its address says. The domain is compared lower-cased, as the functions'
    // isAllowedEmail does.
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@nonstopio[.]com$');
    }

    function isKulapati() {
      return signedIn() && request.auth.token.kulapati == true;
    }

    // A person reads their own profile (a Kulapati reads any) and may change only their display
    // name and team. Creating the profile and the role mirror is the functions' job (Admin SDK).
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isKulapati());
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'team'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && (request.resource.data.team == null
            || (request.resource.data.team is string && request.resource.data.team.size() <= 80));
      allow create, delete: if false;
    }

    // Assignments are keyed by email and stamped with the uid at first sign-in. The assignee
    // reads their own; a Kulapati reads all. Writes go through the assignCourses function.
    match /assignments/{assignmentId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isKulapati());
      allow write: if false;
    }

    // Organisation settings: the allowed domain, the teams list, reminder settings.
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isKulapati();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
