{
  "name": "@gurukul/functions",
  "version": "0.0.0",
  "private": true,
  "description": "Gurukul Cloud Functions (2nd gen): grading, invite claiming, certificates, role grants.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --sourcemap --outfile=lib/index.js --external:@google-cloud/firestore --external:firebase-admin --external:firebase-admin/* --external:firebase-functions --external:firebase-functions/*",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-gurukul \"vitest run -c vitest.emulator.config.ts\""
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "google-auth-library": "^11.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
