{
  "name": "@gurukul/functions",
  "version": "0.0.0",
  "private": true,
  "description": "Gurukul Cloud Functions (2nd gen): grading, invite claiming, certificates, role grants.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --sourcemap --outfile=lib/index.js --external:firebase-admin --external:firebase-admin/* --external:firebase-functions --external:firebase-functions/*",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@gurukul/schema": "*",
    "esbuild": "^0.28.2"
  }
}
